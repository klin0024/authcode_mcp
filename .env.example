# 到 Google Cloud Console > OAuth 用戶端 ID 建立「網頁應用程式」類型的憑證,
# redirect URI 填 OAUTH_REDIRECT_URI 這裡設定的完整網址。
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# 任意長隨機字串,用來簽署/驗證 OAuth state(CSRF 防護),不要外流。
STATE_SECRET=change-me-to-a-long-random-string

# FastMCP 原生設定(https://gofastmcp.com/more/settings),由 FastMCP 自己讀取,不經過我們的 Settings。
# log level:DEBUG / INFO / WARNING / ERROR / CRITICAL。
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
FASTMCP_LOG_LEVEL=info
# 每個 HTTP request 各自獨立,不保留 MCP 協定層的 session。本專案的 session_id 是 tool 參數帶的
# 應用層概念,不依賴 MCP session,所以可以開。
FASTMCP_STATELESS_HTTP=true

# session 在 CacheStore 裡的存活上限(秒)。實際 TTL = min(Google access_token expires_in, 這個值)。
MAX_SESSION_TTL_SECONDS=600

# 逗號分隔,決定要動態註冊哪些 Gmail tool(預設全開 15 個)。
# 例如只想開放讀信、不開放其他操作:GMAIL_ENABLED_TOOLS=gmail_list_messages,gmail_get_message
GMAIL_ENABLED_TOOLS=gmail_list_messages,gmail_get_message,gmail_get_thread,gmail_list_labels,gmail_get_attachment,gmail_send_message,gmail_modify_labels,gmail_archive_message,gmail_trash_message,gmail_untrash_message,gmail_list_drafts,gmail_create_draft,gmail_update_draft,gmail_delete_draft,gmail_send_draft

# 對外可被使用者瀏覽器打到的完整 origin,用來組出 /confirm/{action_id} 連結。
# 通常跟 OAUTH_REDIRECT_URI 是同一台主機。
PUBLIC_BASE_URL=http://localhost:8000

# 待確認動作(例如寄信前的使用者確認)在 CacheStore 裡的存活時間(秒)。
PENDING_ACTION_TTL_SECONDS=300

# state 參數的有效期限(秒),超過就視為 CSRF 驗證失敗,需重新走一次授權連結。
OAUTH_STATE_MAX_AGE_SECONDS=300

# 逗號分隔,決定哪些 tool 呼叫時要先建立待確認動作、等使用者按確認連結才真的執行。
# 原則:新增/修改/刪除(含寄送)一律要經過使用者確認,唯讀查詢不用。
CONFIRM_REQUIRED_TOOLS=gmail_send_message,gmail_modify_labels,gmail_archive_message,gmail_trash_message,gmail_untrash_message,gmail_create_draft,gmail_update_draft,gmail_delete_draft,gmail_send_draft

# 稽核紀錄(誰、何時、對哪個 tool 做了什麼、結果如何)在 AuditStore 裡的存活時間(秒)。
# 注意:啟用稽核需要 gmail_scopes 多帶 userinfo.email,既有使用者要重新走一次授權才能識別身份。
AUDIT_LOG_TTL_SECONDS=2592000
